# Source PostgreSQL (your remote server)
SRC_HOST=localhost        # or your VPS IP if running locally
SRC_PORT=5433             # mapped port from docker-compose.yml
SRC_DB=sreality_dw
SRC_USER=etl
SRC_PASSWORD=changeme     # set to your actual password

# Destination PostgreSQL (university server)
DST_HOST=webik.ms.mff.cuni.cz
DST_PORT=5432
DST_DB=ndbi046
DST_USER=your_username    # your MFF login
DST_PASSWORD=your_password
DST_SCHEMA=your_username  # schema = your username (standard for ndbi046)

# Optional
FACT_LIMIT=1000           # rows per fact table
