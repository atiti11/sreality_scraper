# Dockerfile.airflow
# Multi-stage: copy Java 21 JRE from the official Temurin image into Airflow.
# This avoids any apt repository or GPG key issues entirely.

FROM eclipse-temurin:21-jre-jammy AS java

FROM apache/airflow:2.9.3-python3.11

USER root

# Copy Java 21 JRE from Temurin image
COPY --from=java /opt/java/openjdk /opt/java/openjdk

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="$JAVA_HOME/bin:$PATH"

# Verify
RUN java -version

USER airflow
