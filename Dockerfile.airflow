# Dockerfile.airflow
# Custom Airflow image with Java 21 JRE for running pipeline JARs.
# curl is explicitly installed for reliable large-file downloads (e.g. RUIAN 332MB).

FROM eclipse-temurin:21-jre-jammy AS java

FROM apache/airflow:2.9.3-python3.11

USER root

# Copy Java 21 JRE from Temurin image
COPY --from=java /opt/java/openjdk /opt/java/openjdk

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="$JAVA_HOME/bin:$PATH"

# Ensure curl is installed (used by RuianDownloader for large file downloads)
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Verify both are available
RUN java -version && curl --version

USER airflow
