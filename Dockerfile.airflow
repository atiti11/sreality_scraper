# Dockerfile.airflow
# Custom Airflow image with Java 21 (JRE only) for running pipeline JARs.
# Built once: docker build -f Dockerfile.airflow -t sreality-airflow .

FROM apache/airflow:2.9.3-python3.11

USER root

# Install Java 21 JRE (headless — no GUI, minimal footprint)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openjdk-21-jre-headless \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="$JAVA_HOME/bin:$PATH"

USER airflow
