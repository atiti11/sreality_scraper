# ─────────────────────────────────────────────
# MongoDB connection (used by both scraper and ETL)
# ─────────────────────────────────────────────
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=adminpassword
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_HOST_PORT=27018
MONGO_DATABASE=sreality
MONGO_USERNAME=scraper
MONGO_PASSWORD=changeme

# ─────────────────────────────────────────────
# PostgreSQL data warehouse (used by ETL)
# ─────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_HOST_PORT=5433
PG_DATABASE=sreality_dw
PG_USERNAME=etl
PG_PASSWORD=changeme
PG_SCHEMA=dw

# ─────────────────────────────────────────────
# Sreality scraper
# ─────────────────────────────────────────────
SREALITY_BASE_URL=https://www.sreality.cz/api/cs/v2/estates
PER_PAGE=100
MAX_ESTATES=0
HTTP_CONNECT_TIMEOUT_MS=10000
HTTP_READ_TIMEOUT_MS=30000
REQUEST_DELAY_MS=500

# ─────────────────────────────────────────────
# Telegram notifications (optional)
# Leave blank to disable.
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# ETL processing
# ─────────────────────────────────────────────
# Batch size for streaming MongoDB → PostgreSQL (keep low to limit heap usage)
ETL_BATCH_SIZE=500
# HTTP timeout for downloading RUIAN GeoJSON and CSU CSV (ms)
ETL_HTTP_TIMEOUT_MS=60000

# ─────────────────────────────────────────────
# RUIAN and CSU data source URLs (optional overrides)
# Defaults point to Czech open data portals.
# Only set these if the default URLs change.
# ─────────────────────────────────────────────
# RUIAN_CAST_OBCE_URL=
# RUIAN_OBEC_URL=
# RUIAN_OKRES_URL=
# RUIAN_KRAJ_URL=

# CSU DataStat API — override only if CSU renumbers their dataset IDs (rare)
# CSU_DEMOGRAPHICS_URL=
# DATASTAT_QUERY_POPULATION=400779
# DATASTAT_QUERY_AVG_AGE=400839

# MPSV unemployment data (okres level) — override only if endpoint changes
# MPSV_UNEMPLOYMENT_URL=
