# ─────────────────────────────────────────────
# MongoDB connection
# ─────────────────────────────────────────────
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=sreality
MONGO_USERNAME=scraper
MONGO_PASSWORD=changeme

# ─────────────────────────────────────────────
# Scraper settings
# ─────────────────────────────────────────────
# How often to run the scraper (cron expression: every 6 hours by default)
SCRAPER_CRON=0 0 */6 * * *

# Base URL for sreality API
SREALITY_BASE_URL=https://www.sreality.cz/api/cs/v2/estates

# ─────────────────────────────────────────────
# HTTP client settings
# ─────────────────────────────────────────────
HTTP_CONNECT_TIMEOUT_MS=10000
HTTP_READ_TIMEOUT_MS=30000
