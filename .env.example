# =============================================================================
# Sreality Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ─────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_HOST_PORT=27018          # host port mapping (127.0.0.1 only)
MONGO_DATABASE=sreality
MONGO_USERNAME=scraper
MONGO_PASSWORD=changeme
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=adminpassword

# ─────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_HOST_PORT=5433              # host port mapping (127.0.0.1 only)
PG_DATABASE=sreality
PG_USERNAME=sreality
PG_PASSWORD=changeme
PG_SCHEMA=public
PG_MAX_POOL_SIZE=3

# ─────────────────────────────────────────────
# Sreality API (JAR 1)
# ─────────────────────────────────────────────
SREALITY_BASE_URL=https://www.sreality.cz/api/cs/v2/estates
PER_PAGE=100
MAX_ESTATES=0                  # 0 = unlimited. Set small number for test runs.
REQUEST_DELAY_MS=500           # ms between API calls. 500 is safe for full scrape.
HTTP_CONNECT_TIMEOUT_MS=10000
HTTP_READ_TIMEOUT_MS=30000

# ─────────────────────────────────────────────
# CSU (JAR 3)
# Comma-separated list of XLSX download URLs.
# Full load: include all historical year files.
# Update load: include only the current/latest year file.
#
# Find URLs at: https://www.czso.cz/csu/czso/databaze-demografickych-udaju-za-obce-cr
# Example pattern (update with actual URLs from the CSU website):
# ─────────────────────────────────────────────
CSU_XLSX_URLS=
CSU_YEAR=2024

# ─────────────────────────────────────────────
# Telegram (JAR 5 + JAR 1 scraper notifications)
# Get token from @BotFather. Get chat_id from @userinfobot.
# Leave blank to disable.
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# Airflow
# Generate FERNET_KEY with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ─────────────────────────────────────────────
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=changeme-secret-32chars-minimum!!
# Public URL Caddy serves Airflow on. Used by Airflow for redirects, links and
# secure cookie scope. Set to http://localhost:8080 when running locally.
AIRFLOW_BASE_URL=https://airflow.example.com
