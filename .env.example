# =============================================================================
# Sreality project — environment variables template.
# Copy to .env and fill in your values.
#
# Consumed by:
#   - root docker-compose.yml             (mongodb + JAR scraper)
#   - docker-compose.dashboard.yml        (FastAPI backend + nginx frontend)
#   - Java scraper / ETL pipeline at runtime
#   - Python backend at runtime (python-dotenv walks up to find this file)
#   - scripts/load_*.py                   (RUIAN polygon loaders)
# =============================================================================

# ─────────────────────────────────────────────
# MongoDB — raw scrape storage (JAR1 + ETL)
# ─────────────────────────────────────────────
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=adminpassword
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_HOST_PORT=27018          # host port mapping (127.0.0.1 only)
MONGO_DATABASE=sreality
MONGO_USERNAME=scraper
MONGO_PASSWORD=changeme

# ─────────────────────────────────────────────
# PostgreSQL data warehouse
#
# IMPORTANT: docker-compose's .env parser expands ``$VAR`` references in
# unquoted values, so a password like ``foo$rE`` silently becomes ``foo``.
# Single-quote the value if it contains any of these characters: $ * ' "
#   PG_PASSWORD='my$weird*password'
# ─────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_HOST_PORT=5433              # host port mapping (127.0.0.1 only)
PG_DATABASE=sreality
PG_USERNAME=sreality
PG_PASSWORD=changeme
PG_SCHEMA=public
PG_MAX_POOL_SIZE=5

# ─────────────────────────────────────────────
# Sreality scraper (JAR1)
# ─────────────────────────────────────────────
SREALITY_BASE_URL=https://www.sreality.cz/api/cs/v2/estates
PER_PAGE=100
MAX_ESTATES=0                  # 0 = unlimited. Set small number for test runs.
REQUEST_DELAY_MS=500           # ms between API calls. 500 is safe for full scrape.
HTTP_CONNECT_TIMEOUT_MS=10000
HTTP_READ_TIMEOUT_MS=30000

# ─────────────────────────────────────────────
# CSU (JAR3)
# Comma-separated list of XLSX download URLs.
# Full load: include all historical year files.
# Update load: include only the current/latest year file.
# Find URLs at: https://www.czso.cz/csu/czso/databaze-demografickych-udaju-za-obce-cr
# ─────────────────────────────────────────────
CSU_XLSX_URLS=
CSU_YEAR=2024

# ─────────────────────────────────────────────
# Telegram notifications (optional)
# Get token from @BotFather. Get chat_id from @userinfobot.
# Leave blank to disable.
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# ETL processing
# ─────────────────────────────────────────────
ETL_BATCH_SIZE=500
ETL_HTTP_TIMEOUT_MS=60000

# ─────────────────────────────────────────────
# Airflow
# Generate FERNET_KEY with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ─────────────────────────────────────────────
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=changeme-secret-32chars-minimum!!
AIRFLOW_BASE_URL=https://airflow.example.com

# ─────────────────────────────────────────────
# Dashboard — compose-level (host ports, bind addr)
# Containers always listen internally on 80 (frontend) and 8000 (backend).
# ─────────────────────────────────────────────
FRONTEND_HOST_PORT=8088
BACKEND_HOST_PORT=8000
HOST_BIND=127.0.0.1

# ─────────────────────────────────────────────
# Dashboard backend (FastAPI)
# ─────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─────────────────────────────────────────────
# Dashboard authentication — single user, Basic Auth at both layers.
# Required in production. Leave blank in local dev to disable the gate.
# ─────────────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme
