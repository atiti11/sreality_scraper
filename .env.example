# ─────────────────────────────────────────────
# MongoDB connection
# ─────────────────────────────────────────────
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=sreality
MONGO_USERNAME=scraper
MONGO_PASSWORD=changeme

# ─────────────────────────────────────────────
# Sreality API
# ─────────────────────────────────────────────
SREALITY_BASE_URL=https://www.sreality.cz/api/cs/v2/estates

# Number of estates per listing API call (max ~100 is safe)
PER_PAGE=100

# ─────────────────────────────────────────────
# Development limiter
# Set to a small number (e.g. 20) to test without scraping everything.
# Set to 0 (or leave unset) for unlimited / full scrape.
# ─────────────────────────────────────────────
MAX_ESTATES=0

# ─────────────────────────────────────────────
# HTTP client
# ─────────────────────────────────────────────
HTTP_CONNECT_TIMEOUT_MS=10000
HTTP_READ_TIMEOUT_MS=30000
